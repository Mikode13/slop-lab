{
	"name": "slop-lab",
	"version": "0.1.0",
	"private": true,
	"description": "Deliberately low-quality React demo application, refactored one pull request at a time into MiKode standards.",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mikode13/slop-lab.git"
	},
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"packageManager": "pnpm@11.17.0",
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prepare": "mikode-git-hooks install",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:ai-review",
		"test:ai-review": "node --test \".github/ai-review/tests/*.test.mjs\""
	},
	"dependencies": {
		"axios": "^1.20.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@mikode13/code-quality": "1.0.0",
		"@mikode13/code-style": "1.0.0",
		"@mikode13/git-hooks": "1.0.0",
		"@mikode13/tsconfig": "1.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.10.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	}
}
